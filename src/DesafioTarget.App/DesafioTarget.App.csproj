<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
	  <Compile Remove="estoques.json\**" />
	  <Compile Remove="vendas.json\**" />
	  <EmbeddedResource Remove="estoques.json\**" />
	  <EmbeddedResource Remove="vendas.json\**" />
	  <None Remove="estoques.json\**" />
	  <None Remove="vendas.json\**" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Dados\*.json" CopyToOutputDirectory="PreserveNewest" />
